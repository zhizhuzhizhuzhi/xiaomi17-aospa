# Match the Qualcomm domain declaration: present only in userdebug/eng.
userdebug_or_eng(`

# Read attributes of the stock BSP log root, without granting file access.
allow vendor_subsystem_ramdump vendor_bsp_data_log_file:dir getattr;

# Init grants NET_ADMIN for the stock NETLINK_KOBJECT_UEVENT listener.
allow vendor_subsystem_ramdump self:capability net_admin;

')
