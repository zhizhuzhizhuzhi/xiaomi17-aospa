diff --git a/Power.cpp b/Power.cpp
index be9a1f61083a24470dfda91c9754b447b342acc8..a90a1f308e54b9fdcf774de5cbef61293d65cf6a 100644
--- a/Power.cpp
+++ b/Power.cpp
@@ -97,7 +97,15 @@ constexpr size_t enum_size() {
 ndk::ScopedAStatus Power::setMode(Mode type, bool enabled) {
     LOG(INFO) << "Power setMode: " << static_cast<int32_t>(type) << " to: " << enabled;
 #ifdef MODE_EXT
-    if (setDeviceSpecificMode(type, enabled)) {
+    bool supported = false;
+    if (isDeviceSpecificModeSupported(type, &supported)) {
+        if (!supported) {
+            return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+        }
+        if (!setDeviceSpecificMode(type, enabled)) {
+            return ndk::ScopedAStatus::fromExceptionCodeWithMessage(
+                    EX_ILLEGAL_STATE, "Device-specific power mode operation failed");
+        }
         return ndk::ScopedAStatus::ok();
     }
 #endif
