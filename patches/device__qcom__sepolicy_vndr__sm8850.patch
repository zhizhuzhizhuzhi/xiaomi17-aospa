-hal_attribute_service(vendor_hal_soter, vendor_hal_soteraidl_service)
+# Soter is intentionally callable by ordinary applications on this product.
+# Keep the legacy HIDL service protected; expose only the declared AIDL service.
+allow vendor_hal_soter_client vendor_hal_soteraidl_service:service_manager find;
+add_service(vendor_hal_soter_server, vendor_hal_soteraidl_service)
+allow untrusted_app_all vendor_hal_soteraidl_service:service_manager find;
+binder_call(untrusted_app_all, vendor_hal_soter_server)
+
+# Preserve the original service-lookup test for non-application domains.
+build_test_only(`
+  neverallow {
+    domain
+    -vendor_hal_soter_client
+    -vendor_hal_soter_server
+    -untrusted_app_all
+    -atrace
+    -dumpstate
+    -shell
+    -system_app
+    -traceur_app
+  } vendor_hal_soteraidl_service:service_manager find;
+')
 binder_call(vendor_hal_soter_qti, servicemanager);
