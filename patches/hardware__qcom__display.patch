--- a/composer/Android.bp
+++ b/composer/Android.bp
@@ -1,9 +1,30 @@
+// Stock-stack selection preserves the existing install behavior per device.
+soong_config_module_type {
+    name: "sm8550_composer_install_defaults_type",
+    module_type: "cc_defaults",
+    config_namespace: "sheng_display",
+    bool_variables: ["stock_stack"],
+    properties: ["installable"],
+}
+
+sm8550_composer_install_defaults_type {
+    name: "sm8550_composer_install_defaults",
+    soong_config_variables: {
+        stock_stack: {
+            installable: true,
+            conditions_default: {
+                installable: false,
+            },
+        },
+    },
+}
+
 composer_srcs = ["*.cpp"]
 
