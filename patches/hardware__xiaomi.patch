+/** Stable AIDL V1 wire ABI verified against the pudding OS4 vendor proxy.
+ * Only IFAA's ID-list and opaque command transport are exposed. No key provisioning.
+ * A declared AIDL backend never falls back to the incompatible HIDL interface.
+ */
+private class MlipayAidlClient {
+    companion object {
+        private const val DESCRIPTOR = "vendor.xiaomi.hardware.mlipay.IMlipayService"
+        private const val SERVICE = "$DESCRIPTOR/default"
+        private const val GET_ID_LIST = IBinder.FIRST_CALL_TRANSACTION
+        private const val INVOKE_COMMAND = IBinder.FIRST_CALL_TRANSACTION + 5
+    }
+    private var cached: IBinder? = null
+    fun isDeclared() = ServiceManager.isDeclared(SERVICE)
+    @Synchronized private fun service(): IBinder {
+        cached?.let { return it }
+        val b = connectLazyService()
+        check(b.interfaceDescriptor == DESCRIPTOR) { "Unexpected mlipay descriptor" }
+        val data = Parcel.obtain(); val reply = Parcel.obtain()
+        try {
+            data.writeInterfaceToken(DESCRIPTOR)
+            if (!b.transact(16777215, data, reply, 0)) throw RemoteException("No stable AIDL version")
+            reply.readException()
+            check(reply.readInt() == 1) { "Unsupported mlipay AIDL version" }
+        } finally { data.recycle(); reply.recycle() }
+        b.linkToDeath({ synchronized(this) { if (cached === b) cached = null } }, 0)
+        cached = b
+        return b
+    }
+    /** Subscribe before the one start request, so registration cannot race the caller.
+     * Use the raw AIDL manager: Java ServiceManager's legacy proxy only checks availability.
+     * Await the registration event without a timed lookup/retry loop.
+     */
+    private fun connectLazyService(): IBinder {
+        val manager = IServiceManager.Stub.asInterface(
+            Binder.allowBlocking(BinderInternal.getContextObject()))
+        val connected = CompletableFuture<IBinder>()
+        val notification = object : IServiceCallback.Stub() {
+            override fun onRegistration(name: String, service: IBinder) {
+                connected.complete(service)
+            }
+        }
+        manager.registerForNotifications(SERVICE, notification)
+        return AutoCloseable {
+            manager.unregisterForNotifications(SERVICE, notification)
+        }.use {
+            val published = manager.getService2(SERVICE).getServiceWithMetadata().service
+            if (published != null) connected.complete(published)
+            try {
+                Binder.allowBlocking(connected.get())
+            } catch (error: InterruptedException) {
+                Thread.currentThread().interrupt()
+                throw error
+            }
+        }
+    }
+
+    fun getIdList(bioType: Int): IntArray {
+        val b = service(); val data = Parcel.obtain(); val reply = Parcel.obtain()
+        try {
+            data.writeInterfaceToken(DESCRIPTOR); data.writeInt(bioType)
+            if (!b.transact(GET_ID_LIST, data, reply, 0)) throw RemoteException("ID-list transaction unavailable")
+            reply.readException()
+            return checkNotNull(reply.createIntArray()) { "mlipay returned a null ID list" }
+        } finally { data.recycle(); reply.recycle() }
+    }
+    fun invokeCommand(command: ByteArray): ByteArray? {
+        val b = service(); val data = Parcel.obtain(); val reply = Parcel.obtain()
+        try {
+            data.writeInterfaceToken(DESCRIPTOR)
+            data.writeByteArray(command); data.writeInt(command.size)
+            if (!b.transact(INVOKE_COMMAND, data, reply, 0)) throw RemoteException("Command transaction unavailable")
+            reply.readException()
+            return reply.createByteArray()
+        } finally { data.recycle(); reply.recycle() }
+    }
